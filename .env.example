DATABASE_URL=postgresql://axiom:axiom@127.0.0.1:54329/axiom
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8080
APP_URL=http://localhost:8080
PORT=8080
# Development and production use the current editor. Explicit rollback:
# NEXT_PUBLIC_AXIOM_EDITOR_ENGINE=native
# Development assets never reuse AXIOM_DIST_DIR (the production release path).
# AXIOM_DEV_DIST_DIR=.next/dev-8080
NEXT_PUBLIC_SYNC_URL=ws://localhost:1234
SYNC_PORT=1234
SYNC_INTERNAL_URL=http://127.0.0.1:1234
SYNC_SECRET=replace-with-a-different-32-character-secret
STORAGE_DRIVER=local
STORAGE_PATH=./data/attachments
MAX_UPLOAD_MB=50
# MAX_UPLOAD_MB applies to the legacy import endpoint; Explorer files are fixed
# at 1,000,000,000 bytes and uploaded in 8 MiB resumable requests.
# SMTP_URL=smtps://username:password@smtp.example.org:465
# MAIL_FROM=Axiom <notebook@example.org>
# S3_BUCKET=axiom-research
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://your-compatible-object-store.example.org
# OIDC_DISPLAY_NAME=University account
# OIDC_DISCOVERY_URL=https://identity.example.edu/.well-known/openid-configuration
# OIDC_CLIENT_ID=provided-by-your-institution
# OIDC_CLIENT_SECRET=keep-in-your-secret-store
# Register callback: https://your-axiom-origin/api/auth/callback/institution
# Existing invited users explicitly link a same-email account in Security.
# Optional research tools. AI/OCR are disabled until explicitly configured.
# 32 random bytes encoded as base64; independent of auth/sync credentials.
TOOL_PROVIDER_KEY=
# Comma-separated exact origins, e.g. http://private-inference:8000
TOOL_PROVIDER_ALLOWED_ORIGINS=
# Private, internal-only service from the research-tools Compose profile.
OFFICE_CONVERTER_URL=
OFFICE_CONVERTER_TOKEN=
# Optional CPU OCR; never expose the processing service publicly.
PDF_OCR_URL=
PDF_OCR_TOKEN=
PDF_RESEARCH_OCR_URL=
