# Copy to .env.production, chmod 600, and replace EVERY placeholder.
# Use: docker compose --env-file .env.production ...
# Never run npm run setup, seed, or reset:development on a production host.
APP_URL=https://notes.example.org
BETTER_AUTH_SECRET=replace-with-64-random-hex-characters
SYNC_SECRET=replace-with-different-64-random-hex-characters
POSTGRES_PASSWORD=replace-with-a-separate-random-hex-admin-password
AXIOM_DATABASE_PASSWORD=replace-with-a-separate-random-hex-app-password
AXIOM_IMAGE=axiom:local
AXIOM_DATABASE_IMAGE=axiom-postgres:local
AXIOM_OPERATIONS_IMAGE=axiom-operations:local
AXIOM_BACKUP_PATH=./backups
# Optional extensions remain disabled until the operator completes acceptance.
# Imports are a separate gate; see docs/EXTENSIONS.md before enabling either.
AXIOM_PLUGINS_ENABLED=false
AXIOM_PLUGIN_IMPORTS_ENABLED=false
# Sync is published only on host loopback for an existing host Nginx proxy.
# If this port is occupied, change it and the Nginx upstream together.
# AXIOM_SYNC_HOST_PORT=1234
# Production derives /sync from the HTTPS browser origin. Do not set a dev URL.
# SMTP_URL=smtps://username:password@smtp.example.org:465
# MAIL_FROM=Axiom <notebook@example.org>
# OIDC_DISPLAY_NAME=University account
# OIDC_DISCOVERY_URL=https://identity.example.edu/.well-known/openid-configuration
# OIDC_CLIENT_ID=provided-by-your-institution
# OIDC_CLIENT_SECRET=keep-in-your-secret-store
# OFFICE_CONVERTER_URL=http://office-converter:8090
# OFFICE_CONVERTER_TOKEN=replace-with-a-random-independent-token
# TOOL_PROVIDER_KEY=32-random-bytes-encoded-as-base64
# Optional public DNS hostname resolving to this server, for workspace websites.
# The bundled Caddy verifies approval before automatic certificate issuance.
# Never expose the publication control listener (port 3002) to the internet.
PUBLISH_DOMAIN_TARGET=
# TOOL_PROVIDER_ALLOWED_ORIGINS=https://your-approved-provider.example.org
# Optional private CPU OCR; enable Compose profiles only after docs/SELF_HOSTED_OCR.md acceptance.
# PDF_OCR_URL=http://pdf-ocr:8091
# PDF_OCR_TOKEN=replace-with-at-least-32-random-characters
# PDF_RESEARCH_OCR_URL=http://pdf-research-ocr:8091
