{
  "name": "axiom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "clean:generated": "tsx scripts/ops/clean-generated.ts",
    "staging": "tsx scripts/dev/staging.ts",
    "docs:check": "tsx scripts/verify/check-docs.ts",
    "test:deployment": "tsx scripts/verify/rehearse-deployment.ts",
    "tools:assets": "tsx scripts/build/vendor-tools.ts",
    "setup": "tsx scripts/dev/setup.ts",
    "backup": "tsx scripts/ops/backup.ts",
    "reset:development": "tsx scripts/ops/reset-development.ts",
    "validate:env": "tsx scripts/ops/validate-env.ts",
    "validate:themes": "tsx scripts/verify/validate-themes.ts",
    "fixtures": "tsx scripts/dev/fetch-fixtures.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.mjs *.json",
    "dev": "concurrently -k -n web,sync,worker npm:dev:web npm:dev:sync npm:dev:worker",
    "dev:web": "dotenv -e .env -- next dev apps/web --hostname 127.0.0.1",
    "dev:sync": "dotenv -e .env -- tsx watch apps/sync/src/server.ts",
    "dev:worker": "dotenv -e .env -- tsx watch scripts/ops/workspace-worker.ts",
    "build": "tsx scripts/build/application.ts",
    "start:web": "dotenv -e .env -- next start apps/web",
    "start:sync": "dotenv -e .env -- tsx apps/sync/src/server.ts",
    "start:worker": "dotenv -e .env -- tsx scripts/ops/workspace-worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config dev-service.config.ts",
    "editor:lab": "tsx scripts/dev/editor-lab.ts",
    "test:editor": "playwright test --config editor-lab.config.ts",
    "test:durability": "tsx scripts/verify/verify-durability.ts",
    "db:migrate": "dotenv -e .env -- tsx scripts/ops/migrate.ts",
    "admin": "dotenv -e .env -- tsx scripts/ops/admin.ts",
    "seed": "dotenv -e .env -- tsx scripts/dev/seed.ts",
    "db:local": "tsx scripts/dev/local-db.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/lib-storage": "3.1127.0",
    "@better-auth/cimd": "1.7.3",
    "@better-auth/mcp": "1.7.3",
    "@better-auth/oauth-provider": "1.7.3",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.2.8",
    "@hocuspocus/provider": "4.6.0",
    "@hocuspocus/server": "4.6.0",
    "@lezer/highlight": "1.2.3",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@milkdown/kit": "7.22.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@xmldom/xmldom": "0.9.12",
    "ag-psd": "31.0.2",
    "better-auth": "1.7.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "0.45.2",
    "entities": "^7.0.1",
    "exceljs": "4.4.0",
    "exifreader": "4.45.0",
    "fast-xml-parser": "^5.11.1",
    "file-type": "22.0.2",
    "highlight.js": "^11.11.1",
    "html-to-image": "1.11.13",
    "jszip": "^3.10.1",
    "lib0": "^0.2.114",
    "lucide-react": "^0.577.0",
    "mathlive": "0.110.0",
    "mermaid": "^11.12.2",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.4",
    "tsx": "^4.21.0",
    "y-protocols": "^1.0.6",
    "yazl": "3.3.1",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yazl": "3.3.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "^18.1.0-beta.15",
    "eslint": "^9.39.3",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "4.1.11"
  }
}
