# Replace notes.example.org with your DNS name before installation.
notes.example.org {
    encode zstd gzip
    request_body {
        max_size 55MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    handle /sync {
        reverse_proxy 127.0.0.1:1234
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
