NODE_ENV=production
APP_URL=https://notes.example.org
BETTER_AUTH_URL=https://notes.example.org
BETTER_AUTH_SECRET=replace-with-a-random-64-character-secret
SYNC_SECRET=replace-with-another-random-64-character-secret
DATABASE_URL=postgresql://axiom:replace-password@127.0.0.1:5432/axiom
PORT=3000
SYNC_PORT=1234
SYNC_HOST=127.0.0.1
SYNC_INTERNAL_URL=http://127.0.0.1:1234
# Leave this blank for the same-origin /sync endpoint behind Caddy.
NEXT_PUBLIC_SYNC_URL=
STORAGE_DRIVER=local
STORAGE_PATH=/var/lib/axiom/attachments
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM=Axiom <notebook@example.org>
# STORAGE_DRIVER=s3
# S3_BUCKET=your-private-axiom-bucket
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://your-compatible-object-store.example.org
# OIDC_DISPLAY_NAME=University account
# OIDC_DISCOVERY_URL=https://identity.example.edu/.well-known/openid-configuration
# OIDC_CLIENT_ID=provided-by-your-institution
# OIDC_CLIENT_SECRET=keep-in-your-secret-store
