[Unit]
Description=Axiom live document synchronization
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=axiom
Group=axiom
WorkingDirectory=/opt/axiom
EnvironmentFile=/etc/axiom/axiom.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node --import tsx apps/sync/src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/axiom
UMask=0077

[Install]
WantedBy=multi-user.target
